{
  "name": "@javaabu/forms",
  "version": "0.0.0",
  "description": "React version of the javaabu/forms Laravel Blade components: model binding, old input, Laravel validation errors, Inertia and Wayfinder support, with adapters for Onu, shadcn/ui or any UI framework.",
  "license": "MIT",
  "author": {
    "name": "Javaabu Pvt. Ltd.",
    "url": "https://javaabu.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Javaabu/react-forms.git"
  },
  "homepage": "https://github.com/Javaabu/react-forms#readme",
  "bugs": {
    "url": "https://github.com/Javaabu/react-forms/issues"
  },
  "keywords": [
    "react",
    "forms",
    "laravel",
    "inertia",
    "wayfinder",
    "onu",
    "shadcn",
    "rtl",
    "dhivehi",
    "javaabu"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "docs",
    "resources",
    "llms.txt",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js",
      "require": "./dist/html.cjs"
    },
    "./onu": {
      "types": "./dist/onu.d.ts",
      "import": "./dist/onu.js",
      "require": "./dist/onu.cjs"
    },
    "./onu/editor": {
      "types": "./dist/onu-editor.d.ts",
      "import": "./dist/onu-editor.js",
      "require": "./dist/onu-editor.cjs"
    },
    "./onu/maps": {
      "types": "./dist/onu-maps.d.ts",
      "import": "./dist/onu-maps.js",
      "require": "./dist/onu-maps.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./tailwind.css": "./src/styles/tailwind.css",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "examples": "vite --config examples/vite.config.ts",
    "examples:build": "vite build --config examples/vite.config.ts"
  },
  "peerDependencies": {
    "@javaabu/onu": "^0.2.1",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "@testing-library/react": "^16.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-thaana": "^5.3.0",
    "@javaabu/onu": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/static-renderer": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependenciesMeta": {
    "@javaabu/onu": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@javaabu/i18n"
    ]
  },
  "dependencies": {
    "@javaabu/i18n": "github:Javaabu/i18n#build-on-git-install"
  }
}
